set(binary_dir "@CMAKE_CURRENT_BINARY_DIR@/initialization-${case}")
set(generator "@CMAKE_GENERATOR@")
if(case STREQUAL "debug")
  set(config Debug)
  set(fill AUTO)
  set(expected 1)
elseif(case STREQUAL "debugopt")
  set(config DebugOpt)
  set(fill AUTO)
  set(expected 1)
elseif(case STREQUAL "release")
  set(config Release)
  set(fill AUTO)
  set(expected 0)
elseif(case STREQUAL "on")
  set(config Release)
  set(fill ON)
  set(expected 1)
elseif(case STREQUAL "off")
  set(config Debug)
  set(fill OFF)
  set(expected 0)
elseif(case STREQUAL "multiconfig")
  set(generator "Ninja Multi-Config")
  set(config Debug)
  set(fill AUTO)
  set(expected "$<IF:$<CONFIG:Debug>,1,0>")
else()
  message(FATAL_ERROR "Unknown initialization configuration case ${case}")
endif()
execute_process(COMMAND "@CMAKE_COMMAND@" --fresh
  -S "@CMAKE_CURRENT_SOURCE_DIR@/initialization" -B "${binary_dir}" -G "${generator}"
  "-DCMAKE_CXX_COMPILER=@CMAKE_CXX_COMPILER@" "-DCMAKE_MAKE_PROGRAM=@CMAKE_MAKE_PROGRAM@"
  "-DCMAKE_BUILD_TYPE=${config}" "-DCMAKE_CONFIGURATION_TYPES=Debug;DebugOpt;Release"
  "-DUNI20_SOURCE_DIR=@PROJECT_SOURCE_DIR@" "-DUNI20_FILL_UNINITIALIZED_SNAN=${fill}"
  "-Dconfig=${config}" "-Dexpected=${expected}"
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Initialization configure failed:\n${output}\n${error}")
endif()
set(configs "${config}")
if(case STREQUAL "multiconfig")
  list(APPEND configs Release)
endif()
foreach(config IN LISTS configs)
  execute_process(COMMAND "@CMAKE_COMMAND@" --build "${binary_dir}" --config "${config}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Initialization consumer ${config} failed:\n${output}\n${error}")
  endif()
endforeach()
