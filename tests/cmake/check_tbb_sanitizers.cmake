foreach(case IN ITEMS enabled_commas enabled_semicolons enabled_mixed disabled imported)
  set(build_dir "${test_binary_dir}/${case}")
  file(MAKE_DIRECTORY "${build_dir}")
  execute_process(COMMAND "${CMAKE_COMMAND}"
    -S "${UNI20_SOURCE_DIR}/tests/cmake/tbb_sanitizers" -B "${build_dir}"
    -G "${generator}" "-DCMAKE_CXX_COMPILER=${compiler}"
    "-DUNI20_SOURCE_DIR=${UNI20_SOURCE_DIR}" "-Dcase=${case}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "${case}: ${output}\n${error}")
  endif()
  if(case STREQUAL "imported")
    continue()
  endif()

  file(READ "${build_dir}/compile_commands.json" commands)
  string(JSON count LENGTH "${commands}")
  math(EXPR last "${count} - 1")
  set(seen_provider FALSE)
  set(seen_consumer FALSE)
  foreach(index RANGE ${last})
    string(JSON file GET "${commands}" ${index} file)
    string(JSON command GET "${commands}" ${index} command)
    if(NOT command MATCHES "-fsanitize=address,undefined")
      message(FATAL_ERROR "Lost inherited sanitizer flags: ${command}")
    endif()
    if(file MATCHES "/provider.cpp$")
      set(seen_provider TRUE)
      if(case MATCHES "^enabled_")
        if(NOT command MATCHES "-fsanitize=address,undefined.*-fno-sanitize=all")
          message(FATAL_ERROR "Provider exclusion is missing or ordered before instrumentation: ${command}")
        endif()
        if(NOT command MATCHES "__TBB_RESUMABLE_TASKS_USE_THREADS=1")
          message(FATAL_ERROR "Lost sanitizer-compatible coroutine implementation: ${command}")
        endif()
      elseif(command MATCHES "-fno-sanitize")
        message(FATAL_ERROR "Excluded provider without an active Uni20 sanitizer policy: ${command}")
      endif()
    elseif(file MATCHES "/consumer.cpp$")
      set(seen_consumer TRUE)
      if(command MATCHES "-fno-sanitize")
        message(FATAL_ERROR "Provider exclusion leaked into consumer: ${command}")
      endif()
      if(command MATCHES "__TBB_RESUMABLE_TASKS_USE_THREADS")
        message(FATAL_ERROR "Provider implementation definition leaked into consumer: ${command}")
      endif()
    endif()
  endforeach()
  if(NOT seen_provider OR NOT seen_consumer)
    message(FATAL_ERROR "Missing generated provider or consumer compile command")
  endif()
endforeach()
