# Intentionally retained Uni20 debug DAG metadata. Some symbolizers omit the
# source location of template instances; others omit inline qualification.
# Match the retained factory frame or its header, covering both cases.
# Do not suppress Async generally or disable leak detection.
leak:uni20/async/async_node.hpp
leak:uni20::async::NodeInfo::create<

# MPFR's per-thread caches/pools can outlive terminating provider threads.
# Match actual MPFR C frames, not libmpfr/GMP or Uni20's owning scalar wrappers.
# Anchors matter: "mpfr_atan" also matches apply<&mpfr_atan>, which allocates
# the result payload before calling MPFR and must remain leak-checked.
# Function-based rules also exclude other internal allocations in these frames;
# they are an opt-in test policy, not a claim that MPFR is leak-free.
leak:^mpfr_atan$
leak:^mpfr_cos$
leak:^mpfr_cache$
leak:^mpfr_exp_2$
# Log-Gamma retains a per-thread Bernoulli-number table.
leak:^mpfr_bernoulli_cache$
# Remainder retains temporary mpz limbs in MPFR's thread-local pool. This
# private frame needs matching local MPFR debug symbols; see testing.md.
leak:^mpfr_rem1$
